# OpenAI API 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

# 服务器配置
HOST=0.0.0.0
PORT=8000

# Admin（沿用现有后台密码；生产环境请设置随机 Session Secret）
ADMIN_PASSWORD=0418
ADMIN_SESSION_SECRET=replace_with_a_long_random_value
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=0

# Learning Todo（独立 JSON 数据目录）
TODO_TIMEZONE=Asia/Shanghai
# TODO_DATA_DIR=/www/wwwroot/learningcenter/app/data/learning-todo
